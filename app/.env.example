# Local development configuration
# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GCP_REGION=us-central1

# BigQuery Conversational Data Agent
DATA_AGENT_ID=your-data-agent-id
DATA_AGENT_NAME=projects/your-gcp-project-id/locations/global/dataAgents/your-data-agent-id

# BigQuery Vector Search
POS_CHUNK_EMBEDDINGS_TABLE=your-gcp-project-id.cymbal_gold.pos_manual_chunk_embeddings

# Bigtable Configuration & Cloud Run MCP Microservice
BIGTABLE_INSTANCE=operations-db
BIGTABLE_MCP_URL=https://your-cloud-run-mcp-service.a.run.app
BIGTABLE_MCP_SERVICE_URL=https://your-cloud-run-mcp-service.a.run.app
MCP_INVOKER_SERVICE_ACCOUNT=your-invoker-service-account@developer.gserviceaccount.com

# Model Configuration
GEMINI_MODEL=gemini-3.6-flash

# Telemetry & Monitoring
PROJECT_ID=your-gcp-project-id
REGION=us-central1
BQ_TELEMETRY_DATASET=agent_telemetry
